# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
TZ=Asia/Jakarta
LOG_LEVEL=info

# CORS & Auth
FRONTEND_ORIGINS=https://bemfsmundip.com
AUTH_MODE=cookie
COOKIE_DOMAIN=bemfsmundip.com

# Database
DATABASE_URL=mysql://bemfsm:bemfsm@localhost:3306/bemfsm

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_TTL=7d
PREVIEW_TOKEN_SECRET=change-me-preview-secret-min-32-chars

# Storage
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bemfsm-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
CDN_BASE_URL=http://localhost:9000/bemfsm-media
INLINE_IMAGE_ALLOWED_DOMAINS=localhost,bemfsmundip.com,cdn.bemfsmundip.com

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@bemfsmundip.com

# Redis (opsional)
REDIS_URL=

# Next.js revalidation
NEXT_REVALIDATE_URL=https://bemfsmundip.com/api/revalidate
NEXT_REVALIDATE_SECRET=change-me-revalidate-secret

# Observability
SENTRY_DSN=
METRICS_ENABLED=false

# Bootstrap
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@bemfsmundip.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeMe123!ChangeMe

# Argon2 tuning (opsional)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Throttle
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100